{
    "name": "statamic-addon/popup",
    "description": "Shared vizuall-popup component for Statamic addons",
    "type": "statamic-addon",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Vizuall\\Popup\\": "src/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Popup",
            "provider": "Vizuall\\Popup\\AddonServiceProvider"
        },
        "laravel": {
            "providers": [
                "Vizuall\\Popup\\AddonServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
